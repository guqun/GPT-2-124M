    "append_eot": false
  },
  "training": {
    "batch_size": 2, "seq_len": 128, "world_size": 1,
    "accumulation_steps": 4, "planned_updates": 100,
    "validation_batches": 8, "validation_every": 20,
    "peak_lr": 0.0006, "min_lr": 0.00006, "lr_warmup_updates": 10,
    "weight_decay": 0.1, "betas": [0.9, 0.95], "adam_eps": 1e-8,
    "clip_norm": 1.0,
    "precision": "fp32", "compile": false
  }
