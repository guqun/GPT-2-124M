{
  "name": "gpt2-local-shakespeare-v1",
  "purpose": "本机流程检查；不是 124M/FineWeb 结构优劣结论",
  "budget_status": "proposed_until_benchmark",
  "seed": 42,
  "model": {
    "vocab_size": 50257, "n_positions": 256,
    "n_embd": 128, "n_layer": 2, "n_head": 4,
    "layer_norm_epsilon": 0.00001,
    "embd_pdrop": 0.0, "attn_pdrop": 0.0, "resid_pdrop": 0.0,
    "initializer_range": 0.02
  },
  "data": {
    "kind": "tiny_shakespeare",
    "path": "data/tiny_shakespeare/input.txt",
    "sha256": "86c4e6aa9db7c042ec79f339dcb96d42b0075e16b8fc2e86bf0ca57e2dc565ed",
    "tokenizer": "tiktoken/gpt2",
    "split": "first_90_percent_tokens_train_remaining_val",
